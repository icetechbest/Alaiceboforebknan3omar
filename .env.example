# Generate a unique value and keep it private.
# مهم: خليه ثابت وحطه بنفسك في Railway > Variables (متسبوش الكود يولّده تلقائي)
# عشان ميتغيّرش مع كل Deploy جديد (لو اتغيّر، أي رابط/توكن Dashboard قديم هيبقى غلط).
DASHBOARD_KEY=

# ده بس للتشغيل المحلي على جهازك. على Railway بورت السيرفر بيتحدد تلقائيًا
# عن طريق متغيّر PORT اللي المنصة بتضيفه لوحدها — سيبه فاضي/متلمسوش على Railway.
DASHBOARD_PORT=3030
